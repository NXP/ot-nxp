#MIME_PATTERN="application/x-executable"
#DIR_LIST="cli","ncp"

set -exo pipefail

OT_CMAKE_NINJA_TARGET=${OT_CMAKE_NINJA_TARGET-}
BUILD_DIR="${OT_CMAKE_BUILD_DIR:-build_mcxw30}"

readonly OT_SRCDIR="$(pwd)"
readonly OT_OPTIONS=(
    "-DBUILD_TESTING=OFF"
    "-DCMAKE_EXPORT_COMPILE_COMMANDS=1"
    "-DCMAKE_BUILD_TYPE=Debug"
    "-DOT_NXP_EXPORT_TO_SREC=ON"
    "-DOT_PLATFORM=external"
    "-DOT_SLAAC=ON"
    "-DOT_NXP_PLATFORM_FAMILY=mcxw"
    "-DOT_NXP_PLATFORM=mcxw30"
    "-DNO_THREAD_1_3_FLAGS=ON"
    "-DOT_APP_LOWPOWER=OFF"
)

readonly OT_OPTIONS_NO_RCP=(
    "-DOT_APP_NCP=OFF"
    "-DOT_APP_RCP=OFF"
    "-DOT_RCP=OFF"
    "-DOT_MAC_CSL_RECEIVER_ENABLE=ON"
    "-DOT_APP_LOWPOWER=OFF"
)

readonly OT_OPTIONS_CLI_FTD_BLE_SHELL=(
    "-DOT_NCP_SPI=OFF"
    "-DOT_APP_CLI=OFF"
    "-DOT_APP_RCP=OFF"
    "-DOT_APP_NCP=OFF"
    "-DOT_FTD=ON"
    "-DOT_MTD=OFF"
    "-DOT_BLE_SUPPORT=ON"
    "-DOT_APP_FTD_BLE_SHELL=ON"
    "-DOT_PING_SENDER=ON"
    "-DOT_APP_LOWPOWER=OFF"
    "-DCONF_FILE=${OT_SRCDIR}/examples/hybrid/ot_cli_ftd_ble_shell/prj.conf"
)

build()
{
    local cmakeArgs=("${@}")

    if [ ! "$1" = "folder_not_specified" ]; then
        cmakeArgs=("${@:2}")
        rcp_folder_name="/$1"
    fi

    # shellcheck disable=SC2068
    west build -d "${BUILD_DIR}${rcp_folder_name}" --config debug -b kw43evk . --no_sanity_check -DSDK_GH=$SDK_GH -DUSE_NBU=1 -DFPGA_BUILD=1 -DOT_COMPILE_WARNING_AS_ERROR=ON ${cmakeArgs[@]}
}

build_ot_without_rcp_image()
{
    echo "Building OT without RCP image ..."
    app_folder_name="folder_not_specified"
    local options=("${app_folder_name}")
    options+=("${OT_OPTIONS_NO_RCP[@]}")
    options+=("${OT_OPTIONS[@]}")
    options+=("$@")

    options+=(" -DSDK_RELEASE=$SDK_RELEASE")

    build "${options[@]}"

    if [ $? -eq 1 ]; then
        exit 1
    fi
}

build_ot_cli_ftd_ble_shell()
{
    echo "Building dual mode app OT CLI FTD + BLE_shell ..."
    app_folder_name="ot_cli_ftd_ble_shell"
    local options=("${app_folder_name}")
    options+=("${OT_OPTIONS_CLI_FTD_BLE_SHELL[@]}")
    options+=("${OT_OPTIONS[@]}")
    options+=("$@")
    options+=(" -DSDK_RELEASE=$SDK_RELEASE")
    build "${options[@]}"

    if [ $? -eq 1 ]; then
        exit 1
    fi
}

create_directory_and_build()
{
    if [ "$1" == 'all' ]; then
        build_ot_without_rcp_image "$@"
#        build_ot_cli_ftd_ble_shell "$@"
    elif [ "$1" == 'ot_without_rcp_image' ]; then
        build_ot_without_rcp_image "$@"
    elif [ "$1" == 'ot_cli_ftd_ble_shell' ]; then
        build_ot_cli_ftd_ble_shell "$@"
    else
        echo >&2 "Unsupported action: $1. Supported: all, ot_without_rcp_image, ot_cli_ftd_ble_shell"
        # 128 for Invalid arguments
        exit 128
    fi
}

main()
{
    SDK_GH=ON
    SDK_RELEASE=OFF

    if [ $# == 0 ]; then
        create_directory_and_build all $SDK_RELEASE "$@"
    else
        create_directory_and_build "$1" $SDK_RELEASE "$@"
    fi

}

main "$@"
