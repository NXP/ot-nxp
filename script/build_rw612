main()
{

    OT_NXP_BOARD_NAME_VAL=""
    # Iterate over all positional parameters
    for arg in "$@"; do
        case "$arg" in "-DOT_NXP_BOARD_NAME"*)
            # try to extract '-DOT_NXP_BOARD_NAME' the parameter value
            OT_NXP_BOARD_NAME_VAL="${arg#*-DOT_NXP_BOARD_NAME=}"
            OT_NXP_BOARD_NAME_VAL="${OT_NXP_BOARD_NAME_VAL#\"${OT_NXP_BOARD_NAME_VAL%%\"*}\"}"
            OT_NXP_BOARD_NAME_VAL="${OT_NXP_BOARD_NAME_VAL%\"${OT_NXP_BOARD_NAME_VAL##*\"}}"
            break
            ;;
        esac
    done

    if [[ $OT_NXP_BOARD_NAME_VAL == "rw612_frdm" ]]; then
        target_board_name="frdmrw612"
    fi

    if [ $# == 0 ]; then
        create_directory_and_build all
    else
        create_directory_and_build "$@"
    fi

}

main "$@"
