set -exo pipefail

OT_CMAKE_NINJA_TARGET=${OT_CMAKE_NINJA_TARGET:-}

target_board_name="rdrw612bga"
readonly OT_SRCDIR="$(pwd)"
readonly OT_BR_RTOS_CONFIG_PATH='boards/rw612/freertos/br'
readonly OT_OPTIONS=(
    "-DCMAKE_EXPORT_COMPILE_COMMANDS=1"
    "-DCMAKE_BUILD_TYPE=MinSizeRel"
    "-DOT_NXP_PLATFORM=rw612"
)

readonly OT_OPTIONS_REF_DEVICE=(
        "-DOT_REFERENCE_DEVICE=ON"
        "-DOT_STACK_ENABLE_LOG=ON"
        "-DOPENTHREAD_CONFIG_LOG_LEVEL='4'"
)

readonly OT_OPTIONS_REF_DEVICE_1_1=(
        "-DOT_DUA=OFF"
        "-DOT_MLR=OFF"
        "-DOT_LINK_METRICS_INITIATOR=OFF"
        "-DOT_LINK_METRICS_SUBJECT=OFF"
        "-DOT_CSL_RECEIVER=OFF"
        "-DOT_NETDIAG_CLIENT=ON"
)

readonly OT_OPTIONS_CLI_IPERF=(
    "-DOT_APP_CLI_FREERTOS_IPERF=ON"
)

readonly OT_OPTIONS_BR_WIFI=(
    "-DOT_APP_BR_FREERTOS=ON"
    "-DOT_NXP_LWIP_WIFI=ON"
    # FREERTOS CLI is disabled in this target build as it will be available in the BR app
    "-DOT_APP_CLI_FREERTOS=OFF"
    # FREERTOS config file is different for BR project.
    "-DFREERTOS_CONFIG_FILE_DIRECTORY='${OT_SRCDIR}/${OT_BR_RTOS_CONFIG_PATH}'"
)

readonly OT_OPTIONS_BR_ETH=(
    "-DOT_APP_BR_FREERTOS=ON"
    "-DOT_NXP_LWIP_ETH=ON"
    # FREERTOS CLI is disabled in this target build as it will be available in the BR app
    "-DOT_APP_CLI_FREERTOS=OFF"
    # FREERTOS config file is different for BR project.
    "-DFREERTOS_CONFIG_FILE_DIRECTORY='${OT_SRCDIR}/${OT_BR_RTOS_CONFIG_PATH}'"
)

readonly OT_OPTIONS_NCP_UART=(
    "-DOT_NCP_RADIO=ON"
    "-DOT_NXP_NCP_UART_INTERFACE=ON"
)

readonly OT_OPTIONS_NCP_SPI=(
    "-DOT_NCP_RADIO=ON"
    "-DOT_NXP_NCP_SPI_INTERFACE=ON"
)

readonly OT_OPTIONS_NCP_USB=(
    "-DOT_NCP_RADIO=ON"
    "-DOT_NXP_NCP_USB_INTERFACE=ON"
)

readonly OT_OPTIONS_NCP_SDIO=(
    "-DOT_NCP_RADIO=ON"
    "-DOT_NXP_NCP_SDIO_INTERFACE=ON"
)

build()
{
    local builddir="${OT_CMAKE_BUILD_DIR:-build_rw612}"

    mkdir -p "${builddir}"
    cd "${builddir}"
    mkdir -p "$1"
    cd "${OT_SRCDIR}"

    # shellcheck disable=SC2068
    west build -d "${builddir}/$1" --config release -b ${target_board_name} . --no_sanity_check "${@:2}"
}

create_directory_and_build()
{
    if [ "$1" == 'all' ]; then
        build_ot_cli "$@"
        build_ot_cli_iperf "$@"
        build_otbr_wifi "$@"
        build_otbr_eth "$@"
        # NCP UART apps
        build_ot_cli_ncp_uart "$@"
        build_otbr_wifi_ncp_uart "$@"
        build_otbr_eth_ncp_uart "$@"
        # NCP SPI apps
        build_ot_cli_ncp_spi "$@"
        build_otbr_wifi_ncp_spi "$@"
        build_otbr_eth_ncp_spi "$@"
        # NCP USB apps
        build_ot_cli_ncp_usb "$@"
        build_otbr_wifi_ncp_usb "$@"
        build_otbr_eth_ncp_usb "$@"
        # NCP SDIO apps
        build_ot_cli_ncp_sdio "$@"
        build_otbr_wifi_ncp_sdio "$@"
        build_otbr_eth_ncp_sdio "$@"
        # Reference Device
        build_ot_cli_ref_device "$@"
    elif [ "$1" == 'ot_br_wifi' ]; then
        build_otbr_wifi "$@"
    elif [ "$1" == 'ot_br_eth' ]; then
        build_otbr_eth "$@"
    elif [ "$1" == 'ot_cli' ]; then
        build_ot_cli "$@"
    elif [ "$1" == 'ot_cli_iperf' ]; then
        build_ot_cli_iperf "$@"
    elif [ "$1" == 'ot_br_wifi_ncp_uart' ]; then
        build_otbr_wifi_ncp_uart "$@"
    elif [ "$1" == 'ot_br_eth_ncp_uart' ]; then
        build_otbr_eth_ncp_uart "$@"
    elif [ "$1" == 'ot_cli_ncp_uart' ]; then
        build_ot_cli_ncp_uart "$@"
    elif [ "$1" == 'ot_br_wifi_ncp_spi' ]; then
        build_otbr_wifi_ncp_spi "$@"
    elif [ "$1" == 'ot_br_eth_ncp_spi' ]; then
        build_otbr_eth_ncp_spi "$@"
    elif [ "$1" == 'ot_cli_ncp_spi' ]; then
        build_ot_cli_ncp_spi "$@"
    elif [ "$1" == 'ot_br_wifi_ncp_usb' ]; then
        build_otbr_wifi_ncp_usb "$@"
    elif [ "$1" == 'ot_br_eth_ncp_usb' ]; then
        build_otbr_eth_ncp_usb "$@"
    elif [ "$1" == 'ot_cli_ncp_usb' ]; then
        build_ot_cli_ncp_usb "$@"
    elif [ "$1" == 'ot_br_wifi_ncp_sdio' ]; then
        build_otbr_wifi_ncp_sdio "$@"
    elif [ "$1" == 'ot_br_eth_ncp_sdio' ]; then
        build_otbr_eth_ncp_sdio "$@"
    elif [ "$1" == 'ot_cli_ncp_sdio' ]; then
        build_ot_cli_ncp_sdio "$@"
    elif [ "$1" == 'ot_cli_ref_device' ]; then
        build_ot_cli_ref_device "$@"
    else
        echo >&2 "Unsupported action: $1. Supported:
            all
            ot_cli_iperf
            ot_br_wifi, ot_br_eth, ot_cli
            ot_br_wifi_ncp_uart, ot_br_eth_ncp_uart, ot_cli_ncp_uart
            ot_br_wifi_ncp_spi, ot_br_eth_ncp_spi, ot_cli_ncp_spi
            ot_br_wifi_ncp_usb, ot_br_eth_ncp_usb, ot_cli_ncp_usb
            ot_br_wifi_ncp_sdio, ot_br_eth_ncp_sdio, ot_cli_ncp_sdio
            ot_cli_ref_device"
        # 128 for Invalid arguments
        exit 128
    fi

}


build_ot_cli_ref_device()
{
    local options=("${OT_OPTIONS[@]}")
    options+=("${OT_OPTIONS_REF_DEVICE[@]}")
    # Extract '-DOT_THREAD_VERSION' the parameter value
    for arg in "$@"; do
        case "$arg" in "-DOT_THREAD_VERSION"*)
            # extract '-DOT_THREAD_VERSION' the parameter value
            OT_THREAD_VERSION="${arg#*-DOT_THREAD_VERSION=}"
            break
            ;;
        esac
    done

    if [[ $OT_THREAD_VERSION == "1.1" ]]; then
        options+=("${OT_OPTIONS_REF_DEVICE_1_1[@]}")
    fi

    options+=("${@:2}")
    build rw612_ot_cli "${options[@]}"
}

build_ot_cli()
{
    local options=("${OT_OPTIONS[@]}")
    options+=("${@:2}")
    build rw612_ot_cli "${options[@]}"
}

build_ot_cli_iperf()
{
    local options=("${OT_OPTIONS_CLI_IPERF[@]}")
    options+=("${OT_OPTIONS[@]}")
    options+=("${@:2}")
    build rw612_ot_cli_iperf "${options[@]}"
}

build_otbr_wifi()
{
    local options=("${OT_OPTIONS_BR_WIFI[@]}")
    options+=("${OT_OPTIONS[@]}")
    options+=("${@:2}")
    build rw612_ot_br_wifi "${options[@]}"
}

